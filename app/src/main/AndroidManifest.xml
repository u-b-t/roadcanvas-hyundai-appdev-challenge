<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- 주행 규제를 기어(GEAR_SELECTION, 일반 권한)와 속도(PERF_VEHICLE_SPEED, 실행 중 요청 권한)로 판단한다. -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- 주행 중 화면이 차단되어도 경로를 기록하는 위치 타입 포그라운드 서비스 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 14부터 위치 타입 포그라운드 서비스를 시작하려면 Android 위치 권한이 필요하다. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Android 11부터 시스템 TTS 엔진을 찾으려면 패키지 공개 범위에 선언해야 한다. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <application android:name=".RoadCanvasApplication" android:icon="@mipmap/ic_launcher" android:label="로드캔버스" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <uses-library android:name="android.car" android:required="false" />
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.RoadCanvas.Launch"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에도 진행 화면을 보여주도록 Distraction Optimization을 선언한다.
                 다른 화면은 주행 규제에 따라 앱이 직접 정차 안내로 가린다. -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
        <service
            android:name=".recording.ChallengeRecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <meta-data android:name="com.naver.maps.map.NCP_KEY_ID" android:value="${naverMapClientId}" />
    </application>
</manifest>
